# Google API Key for Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Flask Secret Key (generate a random string)
FLASK_SECRET_KEY=your_flask_secret_key_here

# Optional: Other API Keys
# Google Safe Browsing API Key (optional but recommended)
# Get from: https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here

# === Phase 1: Stability Configuration ===

# Session Configuration (Phase 1.2)
# True = DatabaseSessionService (persistent across restarts) - RECOMMENDED for production
# False = InMemorySessionService (temporary, lost on restart) - Use for testing only
USE_DATABASE_SESSIONS=True

# Flask Auto-Reload (Phase 1.1)
# True = Enable watchdog auto-reload (convenience during active development)
# False = Disable auto-reload (prevents session disruption) - RECOMMENDED
FLASK_USE_RELOADER=False

# === Phase 4.5: Enhanced Observability Configuration ===

# Logging Level
# DEBUG = Full LLM requests/responses, detailed agent operations (development/debugging)
# INFO = Agent lifecycle, tool execution, workflow steps (production)
# WARNING = Potential issues, deprecated features only
# ERROR = Failed operations and exceptions only
LOG_LEVEL=DEBUG

# Detailed LLM Logging (Phase 4.5)
# true = Enable DetailedLoggingPlugin for comprehensive LLM-level debugging
#        Logs: System instructions, conversation history, available tools, function calls, token usage
# false = Standard logging only (recommended for production)
# Note: Set LOG_LEVEL=DEBUG to see full request/response details
DETAILED_LOGGING=true

# Log File: logs/adk_debug.log (automatically created)
# Log Rotation: 10MB per file, 5 backup files (50MB total maximum)

# Environment-Specific Recommendations:
# Development:  LOG_LEVEL=DEBUG, DETAILED_LOGGING=true
# Staging:      LOG_LEVEL=INFO,  DETAILED_LOGGING=true
# Production:   LOG_LEVEL=INFO,  DETAILED_LOGGING=false


